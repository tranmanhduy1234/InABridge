# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you might want to ignore it.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing pipenv install --ignore-pipfile, you may want to ignore Pipfile.lock.
#Pipfile.lock

# poetry
#   According to poetry markup, poetry.lock contains exact versions and should be committed.
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
#   and local settings in .pdm-python.path
.pdm-python.path
#   and build artifacts in __pdm__
__pdm__/

# PEP 582; project packages folder (e.g. pdm)
__pypackages__/

